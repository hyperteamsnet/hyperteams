# HyperTeams — 설정 예시
#
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. 서버 재시작이 필요합니다.
#   cp .env.example .env.local
#
# .env.example 은 git에 커밋되는 설명서입니다. 실제 값은 .env.local 에만 두세요
# (.gitignore가 .env.local 을 제외합니다). 이 파일에는 진짜 비밀번호를 적지 마세요.
#
# ⚠ 이 대시보드는 이 PC에서 임의의 명령을 실행하고 아무 파일이나 읽고 쓸 수 있습니다.
#   접근 권한을 얻는 것 = 이 PC를 얻는 것입니다. 아래 설정을 그렇게 취급하세요.

# ─────────────────────────────────────────────────────────────────────────────
# 도메인·접속 허용은 더 이상 env 로 설정하지 않습니다
# ─────────────────────────────────────────────────────────────────────────────
# 공개 호스트명(대시보드·프리뷰)은 SaaS 터널 호스트명 바인딩(대시보드 [설정] 탭
# = 전역설정)이 관리합니다. 예전의 DASHBOARD_ZONE·DASHBOARD_HOST·
# DASHBOARD_COOKIE_DOMAIN·PREVIEW_HOST_TEMPLATE·PREVIEW_LOGIN_URL 은 제거됐습니다.
# 접속 허용(DASHBOARD_ALLOWED_HOSTS·ALLOWED_IPS)·프록시 신뢰(DASHBOARD_TRUST_PROXY)도
# 제거됐고, 이제 터널 활성 여부(CLOUDFLARE_RUN_TOKEN)와 등록된 호스트명 바인딩에서
# 런타임 파생됩니다(lib/auth.ts). 세션 쿠키는 호스트 전용입니다.

# ─────────────────────────────────────────────────────────────────────────────
# 포트 — ⚠ PORT 는 여기서 설정할 수 없습니다
# ─────────────────────────────────────────────────────────────────────────────
# PORT 는 .env 에 적어도 무시됩니다(Next 가 HTTP 서버를 먼저 띄웁니다). 포트를
# 바꾸려면 package.json 의 -p 를 주거나 셸에서:  PORT=27777 npm run dev
# Next 는 127.0.0.1:27777 에만 바인딩하고, 바깥 접속은 터널(cloudflared→Caddy)이 맡습니다.

# Caddy(라우터)가 듣는 로컬 포트. 비우면 27788. cloudflared ingress 의 service 포트와
# 같아야 합니다. (터널을 열 때만 Caddy 가 뜹니다.)
CADDY_PORT=

# 대시보드(Next)가 듣는 포트. 비우면 27777.
DASHBOARD_PORT=

# ─────────────────────────────────────────────────────────────────────────────
# HyperTeams 터널 — node scripts/setup.mjs 가 채웁니다 (손대지 마세요)
# ─────────────────────────────────────────────────────────────────────────────
# 설치 시 액세스 토큰(tt_)만 넣으면 setup 이 SaaS 에서 실행 토큰·도메인을 받아 채웁니다.
#   HYPERTEAMS_TUNNEL_KEY : SaaS 액세스 토큰 (tt_...). 이 디바이스에 바인딩됨.
#   CLOUDFLARE_RUN_TOKEN  : cloudflared 실행 토큰. 있으면 터널·Caddy 가 기동됩니다.
#   TUNNEL_DOMAIN         : SaaS 존 접미사 (예: platform.com). 공개 호스트명은 [설정] 탭에서 등록.
# ⚠ 손으로 채우지 마세요 — device-mismatch 를 피하려면 setup 으로 받으세요.
HYPERTEAMS_TUNNEL_KEY=
CLOUDFLARE_RUN_TOKEN=
TUNNEL_DOMAIN=

# ─────────────────────────────────────────────────────────────────────────────
# 접속 비밀번호  ★ 외부에 열리는 순간 사실상 유일한 방어선
# ─────────────────────────────────────────────────────────────────────────────
# 아래 둘 중 하나만 채우세요. 해시가 있으면 해시가 이깁니다.
#
# [권장] 해시로 저장 — 평문이 디스크에 남지 않습니다.  npm run hash-password
DASHBOARD_PASSWORD_HASH=

# [간편] 평문. 로컬에서만 쓸 때. 둘 다 비우면 로그인 없이 접속됩니다(이 PC 전용).
# ⚠ 비밀번호에 $ 가 있으면 반드시 \$ 로 이스케이프하세요(.env 가 $이름 을 변수로 확장).
DASHBOARD_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# 개발 서버 자산 허용 호스트 (next dev 전용)
# ─────────────────────────────────────────────────────────────────────────────
# 기본은 이 PC의 LAN 주소를 자동 감지합니다. 보통 비워두면 됩니다. 자동 감지로 알 수
# 없는 이름(터널·VPN·hosts 별칭)으로 접속할 때만 지정하세요. 안 하면 next dev 가
# /_next/* 를 교차 출처로 막아 페이지는 뜨지만 버튼이 조용히 죽습니다.
# 예: DASHBOARD_DEV_ORIGINS=hq.tail1234.ts.net, 192.168.20.*
DASHBOARD_DEV_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# Claude Code CLI 경로
# ─────────────────────────────────────────────────────────────────────────────
# 비워두면 ~/.local/bin/claude(.exe) 를 찾습니다. 브라우저 도구(MCP)에 필요합니다.
# 예: CLAUDE_CLI_PATH=C:\Users\me\.local\bin\claude.exe
CLAUDE_CLI_PATH=

# ─────────────────────────────────────────────────────────────────────────────
# 작업 완료 푸시 알림 (PWA)
# ─────────────────────────────────────────────────────────────────────────────
# 작업이 완료·실패로 끝나면 등록된 브라우저에 알림을 보냅니다. 앱을 닫아 둔 폰에도
# 도착하는 유일한 경로입니다. 비워두면 기능 전체가 조용히 꺼집니다 — 헤더의 종
# 아이콘도 나타나지 않고, 나머지 동작에는 영향이 없습니다.
#
#   pnpm setup       실행 시 자동으로 채워집니다 (이미 있으면 건드리지 않음)
#   pnpm gen-vapid   키만 따로 만들고 싶을 때
#
# ⚠ 키를 바꾸면 알림을 켜 둔 모든 기기가 끊깁니다. 각 기기에서 다시 켜야 합니다.
# 공개키는 비밀이 아닙니다(브라우저가 구독할 때 사용). 개인키만 보호하면 됩니다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스에 남기는 운영자 연락처. 비우면 mailto:admin@localhost 를 씁니다.
# VAPID_SUBJECT=mailto:admin@example.com

# ─────────────────────────────────────────────────────────────────────────────
# 배포 저장소 — pnpm package 실행 시 사용
# ─────────────────────────────────────────────────────────────────────────────
# 패키징한 배포본을 GitHub에 자동 푸시합니다. SSH 키/PAT + 원격 저장소가 미리 있어야 합니다.
# 사용법:  DIST_REPO_URL=https://github.com/your-org/your-dist-repo.git pnpm package
# DIST_REPO_URL=https://github.com/hyperteamsnet/hyperteams.git

# ─────────────────────────────────────────────────────────────────────────────
# 업데이트 확인 · 익명 사용 통계
# ─────────────────────────────────────────────────────────────────────────────
# 통계는 **항상** 나갑니다. 끄는 값이 없습니다 — 예전의 HYPERTEAMS_TELEMETRY 는
# 아무도 읽지 않게 되어 없앴습니다(끌 수 있는 것처럼 보이는 스위치가 남아 있는
# 편이 더 나쁩니다). 수집 항목은 LICENSE 제13조, 구현은 lib/version-report.ts 참고.
#
#   기본  → hyperteams.net 으로 POST. 그 요청이 통계 전송이자 최신 버전 조회입니다.
#   폴백  → 위가 실패하면 GitHub Releases 공개 API 를 GET. 보내는 데이터가 없습니다.
#           (업데이트 알림은 우리 서버가 죽어도 멈추지 않아야 하기 때문입니다.)
#
# 설치 마법사(scripts/setup.mjs)는 라이선스와 함께 이 항목의 수락을 **설치 조건**
# 으로 받습니다 — 거부하면 아무것도 쓰지 않고 종료합니다.
#
# ⚠ 그 게이트는 **설치기의 정책이지 라이선스가 아닙니다**(LICENSE 제12조 제10항).
#   저장소를 clone 해서 직접 빌드하는 경로에는 게이트를 두지 않습니다(라이선스는
#   그대로 적용됩니다 — LICENSE 제2조 제6항의 평가판). 그 경로로 온 설치본도
#   전송 동작은 같습니다.
#
# 끄는 스위치가 없으므로 남은 약속은 하나입니다: **고지에 없는 값은 보내지
# 않는다.** 설정 화면의 안내 문구와 buildDevice() 가 어긋나면 그건 버그입니다.

# 설치할 때 수락한 약관의 판. setup.mjs 의 TERMS_VERSION 이 씁니다.
HYPERTEAMS_TERMS_ACCEPTED=2026-07-28

# 통계 수신 주소. 비우면 통계가 나가지 않고 업데이트 확인만 GitHub 로 폴백합니다.
# HyperTeams Connect 계정 연결(아래)도 같은 주소를 씁니다 — 설정에 저장된 값이
# 이 값을 이깁니다(lib/saas/base-url.ts).
HYPERTEAMS_API_URL=https://hyperteams.net

# ─────────────────────────────────────────────────────────────────────────────
# HyperTeams Connect 계정 연결 — 위의 익명 통계와 **완전히 다른 채널입니다**
# ─────────────────────────────────────────────────────────────────────────────
# 이 시스템을 Connect 워크스페이스에 연결하면 사용량과 (관리자가 켠 경우) 업무
# 지시문이 그 워크스페이스로 올라갑니다. 터널(공개 주소)과는 별개이고, 바깥에서
# 이 PC 로 들어오는 길을 열지 않습니다 — 이 시스템이 나가기만 합니다.
#
#   익명 통계   → 데이터를 받는 곳이 **제조사**, 항상 나가고 끌 수 없음
#   계정 연결   → 데이터를 받는 곳이 **고객사 워크스페이스**, 정하는 사람이 **관리자**
#
# 두 채널은 서로를 건드리지 않습니다. 계정 연결을 끊어도 익명 통계는 그대로 나가고,
# 익명 통계는 관리자가 정하는 것이 아니라 항상 나갑니다.
#
# 연결은 env 로 하지 않습니다 — 대시보드 [설정] → [계정 연결]에서 Connect 가 발급한
# 8자리 코드를 붙여넣으면 됩니다. 액세스 토큰은 위의 HYPERTEAMS_TUNNEL_KEY 와
# **같은 값**을 씁니다(토큰이 터널이 아니라 시스템에 붙습니다). 그래서 이미 터널을
# 쓰던 설치는 업그레이드하는 순간 연결된 상태로 뜹니다.
#
# 무엇이 나가는지는 설정 화면이 그대로 보여 줍니다. 작업 로그 전체(파일 내용·도구
# 출력)는 **어떤 설정에서도 나가지 않습니다.**

# 업데이트 확인 자체를 끕니다 (동의 여부와 무관하게 아무 데도 묻지 않음).
# HYPERTEAMS_UPDATE_CHECK=0
# 폴백 경로가 볼 저장소. 포크가 자기 릴리스를 보게 하려면 바꾸세요.
# HYPERTEAMS_UPDATE_REPO=hyperteamsnet/hyperteams
